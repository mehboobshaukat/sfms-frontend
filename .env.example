# SFMS frontend - environment variables
#
# Copy this file to `.env` and adjust the values:      cp .env.example .env
#
# Notes
#  - Vite only exposes variables that start with VITE_.
#  - Everything here is compiled into the public browser bundle: NEVER put secrets here.
#  - Restart `npm run dev` after editing .env. For a deployed site, set the variable in the
#    host's dashboard and REBUILD/redeploy (values are baked in at build time).

# Base URL of the SFMS API (include the /api prefix, no trailing slash).
#
#   /api  (DEFAULT, recommended)  The website proxies /api/* to the backend, so the browser talks to ONE origin
#         and the HttpOnly refresh cookie is first-party. Works no matter which domains host the site and the
#         API. Dev: Vite's proxy (see vite.config.js). Production: the rewrites in vercel.json - change the
#         destination there if the API ever moves to another domain.
#
#   https://api.sfms.xyz/api      Direct calls. ONLY valid while the site and the API share one registrable
#         domain (sfms.xyz + api.sfms.xyz). The backend must list this site in CORS_ORIGINS.
VITE_API_BASE_URL=/api

# Google sign-in (optional). The OAuth *Web* client ID from Google Cloud Console (public, not a secret).
# Authorized JavaScript origins must include this site's origin. Leave empty to hide the button.
# VITE_GOOGLE_CLIENT_ID=

# Dev only: where `npm run dev` forwards /api and /media (your local backend).
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
