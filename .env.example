# SFMS frontend - environment variables
#
# Copy this file to `.env` and adjust the values:      cp .env.example .env
#
# Notes
#  - Vite only exposes variables that start with VITE_.
#  - Everything here is compiled into the public browser bundle: NEVER put secrets here.
#  - Restart `npm run dev` after editing .env. For a deployed site, set the variable in the
#    host's dashboard and REBUILD/redeploy (values are baked in at build time).

# Base URL of the SFMS backend API: include the /api prefix, no trailing slash.
# Local backend (default):
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Deployed backend (use https, and add this site's origin to the backend's CORS_ORIGINS):
# VITE_API_BASE_URL=https://your-backend-domain.com/api
